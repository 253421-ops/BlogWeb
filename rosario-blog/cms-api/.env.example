DATABASE_URL=sqlite:///./cms.db
# PostgreSQL (docker compose up -d):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/blogcms
# Debe ser IGUAL a JWT_SECRET de los demás servicios (si no pones ninguna, todos usan la de desarrollo)
# SECRET_KEY=cambia-esta-clave-larga-y-aleatoria-de-32-o-mas-caracteres
ACCESS_TOKEN_MINUTES=480
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-contrasena
# Vacías = el build y las métricas se simulan. Cuando existan esas APIs, pon su dirección (ej. http://127.0.0.1:8013)
BUILDER_URL=http://127.0.0.1:8013
METRICS_URL=http://127.0.0.1:8012
UPLOAD_DIR=uploads
CORS_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
