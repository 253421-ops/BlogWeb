# Debe ser IGUAL a SECRET_KEY del CMS y JWT_SECRET de métricas (mínimo 32 caracteres). Sin ninguna, todos usan la de desarrollo.
# JWT_SECRET=
# Dirección pública de la API de métricas: el sitio generado le envía las visitas ahí.
# METRICS_URL=http://127.0.0.1:8012
# SITE_TITLE=Sigo intentándolo

# URL pública de tu Landing en Vercel: el botón "Inicio" y el logotipo del blog vuelven allí
# LANDING_URL=https://brisablog.vercel.app
